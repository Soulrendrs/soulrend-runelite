# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store

# Local dev notes (not for publication)
*.dev.md

# Third-party RuneLite plugin data written into the CWD when the dev client is launched
# from this dir (e.g. a loot tracker's per-boss tallies) — not Soulrend's, never committed.
boss-loot/
# RuneLite icon caches (base64 PNG dumps) written by the dev client — game assets, not source.
/item-icons.json
/hiscore-icons.json
/clan-rank-icons.json

# Claude Code worktrees (local only)
.claude/worktrees/

# Parked source kept out of the build on purpose (see .attic/*/RESTORE.md)
.attic/

# Locally supplied Mixkit recordings are packaged by Gradle, but stay out of source control.
/src/main/resources/com/soulrend/sounds/mixkit-*-normalized.wav
